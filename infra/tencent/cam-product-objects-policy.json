{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "name/cos:PutObject",
        "name/cos:GetObject",
        "name/cos:HeadObject",
        "name/cos:DeleteObject"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/1234567890:your-product-data-1234567890/what-the-repo/production/*"
      ]
    },
    {
      "effect": "allow",
      "action": ["name/cos:GetBucketVersioning"],
      "resource": ["qcs::cos:ap-guangzhou:uid/1234567890:your-product-data-1234567890/*"]
    },
    {
      "effect": "allow",
      "action": ["name/cos:GetBucket", "name/cos:GetBucketObjectVersions"],
      "resource": ["qcs::cos:ap-guangzhou:uid/1234567890:your-product-data-1234567890/*"],
      "condition": {
        "string_like": { "cos:prefix": ["what-the-repo%2Fproduction%2F*"] }
      }
    }
  ]
}
