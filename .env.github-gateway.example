# Non-secret configuration for the dedicated Singapore GitHub gateway. Copy
# this file outside the release tree to
# /opt/what-the-repo-github-gateway/shared/gateway.env.

NODE_ENV=production
GITHUB_GATEWAY_HOST=0.0.0.0
GITHUB_GATEWAY_PORT=8408
GITHUB_GATEWAY_PUBLIC_URL=https://github.example.com
GITHUB_GATEWAY_APPLICATION_CALLBACK_URL=https://example.com/api/auth/github/callback
# Optional fixed admin callback, e.g. https://admin.example.com/api/auth/github/callback.
# Leave empty until the administrator HTTPS origin is configured.
GITHUB_GATEWAY_ADMIN_CALLBACK_URL=
GITHUB_OAUTH_CLIENT_ID=replace-with-production-client-id
