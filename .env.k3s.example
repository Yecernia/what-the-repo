# Non-secret configuration for the first single-node k3s deployment. Copy this
# file outside a release tree to /opt/what-the-repo/shared/k3s.env. Credentials
# belong only in root-owned files under /opt/what-the-repo/shared/secrets.

POSTGRES_DB=what_the_repo
POSTGRES_USER=what_the_repo
POSTGRES_RUNTIME_USER=what_the_repo_runtime
POSTGRES_MAX_CONNECTIONS=60
POSTGRES_INITDB_ARGS=--data-checksums
# The current server contains only disposable development data. Keep WAL
# archiving off until database data becomes worth backing up.
POSTGRES_ARCHIVE_MODE=off
POSTGRES_ARCHIVE_TIMEOUT=60s

# PostgreSQL writes base backups and WAL into a dedicated prefix of the existing
# Guangzhou bucket. This is intentionally one bucket, not a new region/bucket.
POSTGRES_BACKUP_FILE_PREFIX=
POSTGRES_BACKUP_S3_PREFIX=s3://your-product-data-1234567890/postgresql/production
POSTGRES_BACKUP_RETAIN_FULL=7
POSTGRES_BACKUP_PREVENT_WAL_OVERWRITE=true
POSTGRES_BACKUP_S3_SSE=AES256
POSTGRES_BACKUP_AWS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
POSTGRES_BACKUP_AWS_REGION=ap-guangzhou
POSTGRES_BACKUP_AWS_FORCE_PATH_STYLE=false

NODE_ENV=production
WHAT_THE_REPO_LOAD_LOCAL_ENV=0
WHAT_THE_REPO_ROOT=/app
WHAT_THE_REPO_DATA_DIR=/var/lib/what-the-repo
WHAT_THE_REPO_SERVER_HOST=0.0.0.0
WHAT_THE_REPO_SERVER_PORT=8307
WHAT_THE_REPO_REDIS_URL=redis://redis:6379
WHAT_THE_REPO_REDIS_PREFIX=what-the-repo-production
WHAT_THE_REPO_ANALYSIS_QUEUE_CONCURRENCY=1
WHAT_THE_REPO_PROVIDER_CONCURRENCY=2
WHAT_THE_REPO_PROVIDER_GATE_POLL_MS=100
WHAT_THE_REPO_RETENTION_ENABLED=false
WHAT_THE_REPO_API_DB_POOL_MAX=5
WHAT_THE_REPO_ANALYSIS_DB_POOL_MAX=5
WHAT_THE_REPO_MIGRATION_DB_POOL_MAX=2
WHAT_THE_REPO_DB_CONNECTION_RESERVE=10
WHAT_THE_REPO_DB_IDLE_TIMEOUT_MS=30000
WHAT_THE_REPO_DB_CONNECTION_TIMEOUT_MS=10000
WHAT_THE_REPO_SESSION_LOCK_WAIT_TIMEOUT_MS=600000

WHAT_THE_REPO_COS_BUCKET=your-product-data-1234567890
WHAT_THE_REPO_COS_REGION=ap-guangzhou
WHAT_THE_REPO_COS_PREFIX=what-the-repo/production
WHAT_THE_REPO_COS_DOMAIN=

WHAT_THE_REPO_GITHUB_GATEWAY_URL=https://github.example.com
WHAT_THE_REPO_WEB_URL=https://example.com
WHAT_THE_REPO_PUBLIC_DOMAIN=example.com

WHAT_THE_REPO_FREE_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_FREE_PROVIDER_MODEL=deepseek-v4-flash
WHAT_THE_REPO_ANALYSIS_PROVIDER_ID=deepseek
WHAT_THE_REPO_ANALYSIS_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_ANALYSIS_PROVIDER_MODEL=deepseek-v4-flash
WHAT_THE_REPO_FEEDBACK_PROVIDER_ID=deepseek
WHAT_THE_REPO_FEEDBACK_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_FEEDBACK_PROVIDER_MODEL=deepseek-v4-flash

# One global, manually reviewed Evolution Worker. Its Provider key remains in a
# separate root-only Secret file and its check containers have no network.
WHAT_THE_REPO_EVOLUTION_PROVIDER_ID=deepseek
WHAT_THE_REPO_EVOLUTION_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_EVOLUTION_PROVIDER_MODEL=deepseek-v4-flash
WHAT_THE_REPO_EVOLUTION_SANDBOX_PLATFORM=linux/amd64
WHAT_THE_REPO_EVOLUTION_INTERVAL_MS=30000
WHAT_THE_REPO_EVOLUTION_TASK_LIMIT=1
WHAT_THE_REPO_EVOLUTION_QUEUE_LIMIT=10
WHAT_THE_REPO_EVOLUTION_DB_POOL_MAX=2
WHAT_THE_REPO_EVOLUTION_MAX_STEPS=40
WHAT_THE_REPO_EVOLUTION_MAX_TIME_MS=900000
WHAT_THE_REPO_EVOLUTION_MAX_TOKENS=120000
WHAT_THE_REPO_EVOLUTION_MAX_COST_USD=1
WHAT_THE_REPO_EVOLUTION_THINKING_LEVEL=medium

# These are deliberately conservative until the production baseline test records
# actual latency, memory, and Provider cost on the 4-core server.
WHAT_THE_REPO_QUOTA_MAX_PROJECTS=20
WHAT_THE_REPO_QUOTA_CREATIONS_PER_HOUR=10
WHAT_THE_REPO_QUOTA_ACTIVE_ANALYSIS_JOBS=2
WHAT_THE_REPO_QUOTA_STORAGE_BYTES=4294967296
WHAT_THE_REPO_QUOTA_PROVIDER_CALLS_PER_MINUTE=30
WHAT_THE_REPO_QUOTA_PROVIDER_COST_USD_PER_DAY=1
WHAT_THE_REPO_QUOTA_PROVIDER_RESERVATION_USD=0.01
WHAT_THE_REPO_QUOTA_PROVIDER_DEPLOYMENT_CALLS_PER_MINUTE=120
WHAT_THE_REPO_QUOTA_PROVIDER_DEPLOYMENT_COST_USD_PER_DAY=5
WHAT_THE_REPO_MCP_REQUESTS_PER_MINUTE=60

# Tavily basic search: inject the key from a mounted secret file.
WHAT_THE_REPO_WEB_SEARCH_API_KEY_FILE=

# Optional public filing label compiled into the Web build; use your own record.
VITE_ICP_RECORD=
