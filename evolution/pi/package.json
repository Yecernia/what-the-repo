{
  "name": "what-the-repo-pi-evolution",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:runtime": "node scripts/build-platform-budget.mjs && tsc -p tsconfig.runtime.json",
    "start:feedback-worker": "npm run build:runtime && node .dist/src/worker-main.js",
    "feedback:once": "npm run build:runtime && node .dist/src/worker-main.js once",
    "feedback:review": "npm run build:runtime && node .dist/src/worker-main.js review",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.mjs",
    "probe:docker": "tsc -p tsconfig.test.json && node scripts/docker-runtime-probe.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "bullmq": "^6.2.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "^8.21.0",
    "typescript": "6.0.2"
  },
  "license": "MIT"
}
