{
  "name": "what-the-repo-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "dev": "node --import tsx src/main.ts",
    "start": "node dist/main.js",
    "start:analysis-worker": "node dist/analysis/worker-main.js",
    "start:github-gateway": "node dist/github-gateway/main.js",
    "db:migrate": "node --import tsx src/db-cli.ts migrate",
    "db:import-files": "node --import tsx src/db-cli.ts import-files",
    "eval:fixture": "node --import tsx src/evals/product-run.ts fixture",
    "eval:local": "node --import tsx src/evals/product-run.ts local",
    "eval:conversation": "tsc -p tsconfig.test.json && node --import tsx src/evals/conversation-run.ts",
    "eval:evidence-graph": "node --import tsx src/evals/evidence-graph-v2.ts",
    "smoke:cos": "node --import tsx src/smoke/tencent-cos-object-store-main.ts",
    "quality": "node --import tsx src/evals/quality-gate.ts",
    "quality:all": "node --import tsx src/evals/quality-gate.ts --all"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@fastify/cookie": "11.1.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "bullmq": "^6.2.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "fastify": "5.12.4",
    "fflate": "0.8.3",
    "html-to-text": "10.0.1",
    "ioredis": "^5.11.1",
    "pg": "8.23.0",
    "tree-sitter-c": "0.23.6",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.23.12",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typebox": "1.3.7",
    "typescript": "6.0.2",
    "web-tree-sitter": "0.26.8",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "tsx": "4.20.6"
  },
  "license": "MIT"
}
