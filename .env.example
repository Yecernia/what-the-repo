# Copy to .env for Docker Compose. Use URL-safe values because the database
# password is interpolated into DATABASE_URL inside compose.yaml.
# Product name: what-the-repo
POSTGRES_DB=what_the_repo
# Administrator used only by PostgreSQL bootstrap, migrations and backups.
POSTGRES_USER=what_the_repo
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_PASSWORD_FILE=
# Non-superuser used by API, analysis-worker, scheduler and evolution-worker.
POSTGRES_RUNTIME_USER=what_the_repo_runtime
POSTGRES_RUNTIME_PASSWORD=replace-with-a-different-long-random-url-safe-password
POSTGRES_RUNTIME_PASSWORD_FILE=
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_INITDB_ARGS=--data-checksums
# PostgreSQL continuously archives WAL while this is on. WAL is the ordered
# change log needed to recover writes made after the latest base backup.
POSTGRES_ARCHIVE_MODE=on
POSTGRES_ARCHIVE_TIMEOUT=60s
# Local Compose stores backups in a separate Docker volume. For production COS,
# set this to an empty value and fill the S3-compatible settings below.
POSTGRES_BACKUP_FILE_PREFIX=/var/lib/postgresql/backup
POSTGRES_BACKUP_S3_PREFIX=
POSTGRES_BACKUP_RETAIN_FULL=7
POSTGRES_BACKUP_PREVENT_WAL_OVERWRITE=true
POSTGRES_BACKUP_S3_SSE=
# Tencent COS example values:
#   endpoint: https://cos.ap-guangzhou.myqcloud.com
#   region: ap-guangzhou
#   prefix: s3://your-product-data-1234567890/postgresql/production
# COS supports virtual-hosted S3 addressing, so force-path-style stays false.
POSTGRES_BACKUP_AWS_ENDPOINT=
POSTGRES_BACKUP_AWS_REGION=
POSTGRES_BACKUP_AWS_FORCE_PATH_STYLE=false
POSTGRES_BACKUP_AWS_ACCESS_KEY_ID=
POSTGRES_BACKUP_AWS_ACCESS_KEY_ID_FILE=
POSTGRES_BACKUP_AWS_SECRET_ACCESS_KEY=
POSTGRES_BACKUP_AWS_SECRET_ACCESS_KEY_FILE=
POSTGRES_BACKUP_AWS_SESSION_TOKEN=
POSTGRES_BACKUP_AWS_SESSION_TOKEN_FILE=
# DATABASE_URL is assembled by Compose. For a local PostgreSQL installation,
# set it explicitly in .secrets/local.env instead of enabling Compose below.
DATABASE_URL_FILE=
DATABASE_ADMIN_URL_FILE=

# Optional Redis/BullMQ delivery layer. PostgreSQL remains authoritative for jobs.
WHAT_THE_REPO_REDIS_URL=redis://127.0.0.1:6379
WHAT_THE_REPO_REDIS_PREFIX=what-the-repo
WHAT_THE_REPO_ANALYSIS_QUEUE_CONCURRENCY=1
WHAT_THE_REPO_PROVIDER_CONCURRENCY=4
WHAT_THE_REPO_PROVIDER_GATE_POLL_MS=100
# Direct local startup runs retention; Compose assigns it to the singleton scheduler service.
WHAT_THE_REPO_RETENTION_ENABLED=true
# Direct local startup uses this pool size. Compose uses the role-specific limits below.
WHAT_THE_REPO_DB_POOL_MAX=10
WHAT_THE_REPO_API_DB_POOL_MAX=10
WHAT_THE_REPO_ANALYSIS_DB_POOL_MAX=8
WHAT_THE_REPO_SCHEDULER_DB_POOL_MAX=2
WHAT_THE_REPO_MIGRATION_DB_POOL_MAX=2
# Keep this many ordinary PostgreSQL connections unused for maintenance and recovery.
WHAT_THE_REPO_DB_CONNECTION_RESERVE=10
WHAT_THE_REPO_DB_IDLE_TIMEOUT_MS=30000
WHAT_THE_REPO_DB_CONNECTION_TIMEOUT_MS=10000
# Bounds only Session lock waiting; an active Agent turn is not stopped by this value.
WHAT_THE_REPO_SESSION_LOCK_WAIT_TIMEOUT_MS=600000
# Optional internal metrics endpoint token. Production must set this value;
# without it /metrics intentionally returns 404.
WHAT_THE_REPO_METRICS_TOKEN=
WHAT_THE_REPO_METRICS_TOKEN_FILE=
# Standalone worker/scheduler bind. Compose pins its internal metrics network to
# 0.0.0.0:9464 so Prometheus can reach each container without publishing it.
WHAT_THE_REPO_METRICS_HOST=127.0.0.1
WHAT_THE_REPO_METRICS_PORT=9464
PROMETHEUS_RETENTION_TIME=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GF_SECURITY_ADMIN_PASSWORD_FILE=

# Optional Tencent COS object storage. Leave blank to use the local product-data adapter.
WHAT_THE_REPO_COS_BUCKET=
WHAT_THE_REPO_COS_REGION=ap-guangzhou
WHAT_THE_REPO_COS_SECRET_ID=
WHAT_THE_REPO_COS_SECRET_ID_FILE=
WHAT_THE_REPO_COS_SECRET_KEY=
WHAT_THE_REPO_COS_SECRET_KEY_FILE=
# Required only when SecretId/SecretKey are temporary STS credentials.
WHAT_THE_REPO_COS_SECURITY_TOKEN=
WHAT_THE_REPO_COS_SECURITY_TOKEN_FILE=
WHAT_THE_REPO_COS_PREFIX=what-the-repo
WHAT_THE_REPO_COS_DOMAIN=
# Real COS validation uses scripts/test-tencent-cos.ps1 with a separate ignored
# .secrets/tencent-cos-smoke.env file and requires temporary STS credentials.

# Hosted product identity: GitHub OAuth plus user-selected guest sessions.
GITHUB_OAUTH_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-github-oauth-client-secret
GITHUB_OAUTH_CLIENT_SECRET_FILE=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8307/api/auth/github/callback
WHAT_THE_REPO_WEB_URL=http://127.0.0.1:5307
WHAT_THE_REPO_SESSION_SECRET=replace-with-at-least-32-random-characters
WHAT_THE_REPO_SESSION_SECRET_FILE=
WHAT_THE_REPO_KEY_ENCRYPTION_SECRET=replace-with-a-different-32-character-random-secret
WHAT_THE_REPO_KEY_ENCRYPTION_SECRET_FILE=

# Generate different random values for every machine. MCP remains an external
# adapter and must be bound to an explicit GitHub owner, never the old local user.
WHAT_THE_REPO_MCP_TOKEN=replace-with-at-least-32-random-characters
WHAT_THE_REPO_MCP_TOKEN_FILE=
WHAT_THE_REPO_MCP_TOKENS_JSON=
WHAT_THE_REPO_MCP_TOKENS_JSON_FILE=
WHAT_THE_REPO_MCP_OWNER_ID=github:replace-with-numeric-github-user-id
WHAT_THE_REPO_MCP_REQUESTS_PER_MINUTE=60

# Host Nginx public edge deployment. Keep the default Compose loopback-only;
# the host edge owns TCP 80/443 and forwards to the Web gateway on 127.0.0.1.
WHAT_THE_REPO_PUBLIC_DOMAIN=example.com

# Deployment-owned free experience model. This key is isolated from personal
# user settings and is never returned to the browser.
WHAT_THE_REPO_FREE_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_FREE_PROVIDER_MODEL=deepseek-flash
WHAT_THE_REPO_FREE_PROVIDER_API_KEY=
WHAT_THE_REPO_FREE_PROVIDER_API_KEY_FILE=
WHAT_THE_REPO_FREE_PROVIDER_API_KEY_SOURCE=.secrets/free-provider-api-key.txt

# Deployment-owned repository analysis model. Empty URL/model/key values reuse
# the free-experience provider above; this credential is never sent to the browser.
WHAT_THE_REPO_ANALYSIS_PROVIDER_ID=deepseek
WHAT_THE_REPO_ANALYSIS_PROVIDER_BASE_URL=
WHAT_THE_REPO_ANALYSIS_PROVIDER_MODEL=
WHAT_THE_REPO_ANALYSIS_PROVIDER_API_KEY=
WHAT_THE_REPO_ANALYSIS_PROVIDER_API_KEY_FILE=

# Deployment-owned feedback analysis. The API never uses a user's key for
# this asynchronous worker. If these are empty, the free Provider key above
# is used as a local fallback.
WHAT_THE_REPO_FEEDBACK_PROVIDER_ID=deepseek
WHAT_THE_REPO_FEEDBACK_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_FEEDBACK_PROVIDER_MODEL=deepseek-flash
WHAT_THE_REPO_FEEDBACK_PROVIDER_API_KEY=
WHAT_THE_REPO_FEEDBACK_PROVIDER_API_KEY_FILE=

# The global Skill-evolution worker is a separate process. These values are
# consumed by the deployment-owned evolution composition, not by the chat API.
WHAT_THE_REPO_EVOLUTION_PROVIDER_ID=deepseek
WHAT_THE_REPO_EVOLUTION_PROVIDER_BASE_URL=https://api.deepseek.com
WHAT_THE_REPO_EVOLUTION_PROVIDER_MODEL=deepseek-flash
WHAT_THE_REPO_EVOLUTION_PROVIDER_API_KEY=
WHAT_THE_REPO_EVOLUTION_PROVIDER_API_KEY_FILE=
# The evolution profile starts one global worker. Its model process can reach
# the configured Provider, while every candidate check runs in a separate
# no-network Docker container pinned to the locally inspected image digest.
WHAT_THE_REPO_EVOLUTION_SANDBOX_PLATFORM=linux/amd64
WHAT_THE_REPO_EVOLUTION_INTERVAL_MS=30000
WHAT_THE_REPO_EVOLUTION_TASK_LIMIT=4
WHAT_THE_REPO_EVOLUTION_QUEUE_LIMIT=20
WHAT_THE_REPO_EVOLUTION_MAX_STEPS=40
WHAT_THE_REPO_EVOLUTION_MAX_TIME_MS=900000
WHAT_THE_REPO_EVOLUTION_MAX_TOKENS=120000
WHAT_THE_REPO_EVOLUTION_MAX_COST_USD=10

# Persistent per-owner limits shared by every TypeScript server instance.
WHAT_THE_REPO_QUOTA_MAX_PROJECTS=20
WHAT_THE_REPO_QUOTA_CREATIONS_PER_HOUR=30
WHAT_THE_REPO_QUOTA_ACTIVE_ANALYSIS_JOBS=2
WHAT_THE_REPO_QUOTA_STORAGE_BYTES=4294967296
WHAT_THE_REPO_QUOTA_PROVIDER_CALLS_PER_MINUTE=60
WHAT_THE_REPO_QUOTA_PROVIDER_COST_USD_PER_DAY=10
WHAT_THE_REPO_QUOTA_PROVIDER_RESERVATION_USD=0.01
WHAT_THE_REPO_QUOTA_PROVIDER_DEPLOYMENT_CALLS_PER_MINUTE=240
WHAT_THE_REPO_QUOTA_PROVIDER_DEPLOYMENT_COST_USD_PER_DAY=20

# The approved Skill registry is shared by the online TypeScript service and
# the separately run Pi evolution worker. Leave the default under the product
# data directory unless deployment mounts a dedicated durable volume.
# WHAT_THE_REPO_SKILL_VERSIONS_ROOT=.local/what-the-repo-data/skill-versions
# WHAT_THE_REPO_EVOLUTION_STATE_ROOT=.local/what-the-repo-data/evolution-state
# WHAT_THE_REPO_EVOLUTION_WORKSPACE_ROOT=.local/what-the-repo-data/evolution-workspaces
# A custom deployment can still override the repository-owned composition with
# a compiled module exporting createEvolutionRuntime().
# WHAT_THE_REPO_EVOLUTION_COMPOSITION=C:/deploy/what-the-repo-evolution-composition.mjs

# Tavily basic search: configure locally; never commit the actual key.
WHAT_THE_REPO_WEB_SEARCH_API_KEY=
WHAT_THE_REPO_WEB_SEARCH_API_KEY_FILE=

# Optional public filing label compiled into the Web build; use your own record.
VITE_ICP_RECORD=
